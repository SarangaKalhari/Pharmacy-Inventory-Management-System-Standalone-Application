<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.CheckReportController">

    <children>

        <Label layoutX="20" layoutY="15" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Daily Stock &amp; Expiry Check" />

        <!-- Buttons -->
        <HBox layoutX="20" layoutY="60" spacing="15">
            <Button fx:id="btnLowStock" onAction="#loadLowStock" text="Low Stock Report" />
            <Button fx:id="btnExpired" onAction="#loadExpired" text="Expired Medicines" />
            <Button fx:id="btnExpireSoon" onAction="#loadExpiringSoon" text="Expiring Soon (7 Days)" />
        </HBox>

        <!-- Table -->
        <TableView fx:id="tblReport" layoutX="20" layoutY="110" prefHeight="450" prefWidth="860">

            <columns>
                <TableColumn fx:id="colMedId" prefWidth="120" text="Medicine ID" />
                <TableColumn fx:id="colName" prefWidth="200" text="Medicine Name" />
                <TableColumn fx:id="colQty" prefWidth="100" text="Stock Qty" />
                <TableColumn fx:id="colExpire" prefWidth="150" text="Expire Date" />
                <TableColumn fx:id="colStatus" prefWidth="150" text="Status" />
            </columns>

        </TableView>

    </children>
</AnchorPane>
