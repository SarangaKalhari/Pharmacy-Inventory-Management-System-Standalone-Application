<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="635.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.SalesReportController">

    <BorderPane>

        <!-- Top -->
        <top>
            <HBox spacing="10" style="-fx-padding:10; -fx-background-color:#1e293b;">
                <Button onAction="#loadDaily" style="-fx-background-color: #1e293b;" text="Daily" textFill="#fffefe">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <Button onAction="#loadWeekly" style="-fx-background-color: #1e293b;" text="Weekly" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font></Button>
                <Button onAction="#loadMonthly" style="-fx-background-color: #1e293b;" text="Monthly" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <DatePicker fx:id="datePicker" />
            </HBox>
        </top>

        <!-- Center -->
        <center>
            <VBox prefHeight="643.0" prefWidth="635.0" spacing="10" style="-fx-padding:15;">

                <!-- Summary Cards -->
                <HBox spacing="15">
                    <Label fx:id="lblTotalSales" text="Total Sales: 0.00" />
                    <Label fx:id="lblInvoices" text="Invoices: 0" />
                    <Label fx:id="lblItems" text="Items Sold: 0" />
                </HBox>

                <!-- Table -->
                <TableView fx:id="tblSales" prefHeight="251.0" prefWidth="521.0">
                    <columns>
                        <TableColumn fx:id="colInvoiceId" prefWidth="119.99996680021286" text="Invoice ID" />
                        <TableColumn fx:id="colDate" prefWidth="223.99998474121094" text="Date" />
                        <TableColumn fx:id="colTotal" prefWidth="246.40005493164062" text="Total Amount" />
                    </columns>
                </TableView>

                <!-- Chart -->
                <BarChart fx:id="salesChart" prefHeight="329.0" prefWidth="542.0">
                    <xAxis>
                        <CategoryAxis label="Date" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Sales" />
                    </yAxis>
                </BarChart>

            </VBox>
        </center>

    </BorderPane>


</AnchorPane>
