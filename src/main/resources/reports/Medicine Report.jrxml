<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MedicineInventory" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <field name="Medicine_ID" class="java.lang.String"/>
    <field name="Name" class="java.lang.String"/>
    <field name="Brand" class="java.lang.String"/>
    <field name="Batch_No" class="java.lang.String"/>
    <field name="Qty" class="java.lang.Integer"/>
    <field name="Unit_Price" class="java.lang.Double"/>
    <field name="Exp_Date" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="80" splitType="Stretch">
            <frame>
                <reportElement mode="Opaque" x="-20" y="-20" width="595" height="90" backcolor="#1B3A2E"/>
                <staticText>
                    <reportElement x="20" y="20" width="310" height="43" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle">
                        <font size="26" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Medicine Inventory]]></text>
                </staticText>
                <staticText>
                    <reportElement x="395" y="43" width="180" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="12" isItalic="true"/>
                    </textElement>
                    <text><![CDATA[Stock Status Report]]></text>
                </staticText>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="35" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="5" width="555" height="25" backcolor="#F0F0F0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="5" width="70" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="5" width="130" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Medicine Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="5" width="90" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Brand]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="5" width="50" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="5" width="100" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price (LKR)]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="5" width="105" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Expiry Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Medicine_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="0" width="130" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="90" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Brand}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="290" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Qty}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="340" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Unit_Price}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="450" y="0" width="105" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{Exp_Date}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="22" width="555" height="1" forecolor="#E0E0E0"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="435" y="10" width="100" height="30"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="0" y="10" width="100" height="30"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>